    <application>
        <receiver
            android:name="com.islami.Aha.debug.DebugReminderTrigger"
            android:exported="true">
            <intent-filter>
                <action android:name="com.islami.Aha.debug.TRIGGER_REMINDER" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
