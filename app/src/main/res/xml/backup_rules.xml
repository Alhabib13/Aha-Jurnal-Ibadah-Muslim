<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Prevent restoring stale DB snapshots across schema versions. -->
    <exclude domain="database" path="aha_db"/>
    <exclude domain="database" path="aha_db-wal"/>
    <exclude domain="database" path="aha_db-shm"/>

    <!-- Keep auth/session/user preference data out of backup payload. -->
    <exclude domain="sharedpref" path="aha_prefs.xml"/>
</full-backup-content>
