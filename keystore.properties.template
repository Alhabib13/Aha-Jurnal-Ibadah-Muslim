## FILE INI HARUS TETAP DI LUAR GIT — JANGAN HAPUS DARI .gitignore
## Isi nilai-nilai di bawah ini sesuai keystore kamu:

# Path ke file .jks kamu (relatif dari root project, atau absolute)
storeFile=release.jks

# Password untuk keystore (bukan key)
storePassword=ISI_PASSWORD_KEYSTORE_KAMU

# Alias key di dalam keystore (nama waktu keygen)
keyAlias=ISI_ALIAS_KEY_KAMU

# Password untuk key alias
keyPassword=ISI_PASSWORD_KEY_KAMU
