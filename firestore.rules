rules_version = '2';
service cloud.firestore {
  function isSignedIn() {
    return request.auth != null;
  }

  function isAdmin() {
    return isSignedIn() && (
      request.auth.token.admin == true ||
      request.auth.token.role == "admin" ||
      get(/databases/$(database)/documents/users/$(request.auth.uid)/meta/profile).data.role == "admin"
    );
  }

  match /databases/{database}/documents {
    // Client may read default fardhu metadata, but can never write it.
    match /fardhu_defaults/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Global feature flags controlled by admin only.
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User private sunnah habits.
    match /users/{userId}/sunnah_habits/{habitId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // User meta profile, e.g. role marker written by backend/admin only.
    match /users/{userId}/meta/{docId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if false;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Deny all other paths by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
