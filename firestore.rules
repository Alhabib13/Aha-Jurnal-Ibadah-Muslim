rules_version = '2';
service cloud.firestore {
  function isSignedIn() {
    return request.auth != null;
  }

  function isAdmin() {
    return isSignedIn() && (
      request.auth.token.admin == true ||
      request.auth.token.role == "admin" ||
      get(/databases/$(database)/documents/users/$(request.auth.uid)/meta/profile).data.role == "admin"
    );
  }

  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

  match /databases/{database}/documents {
    // Client may read default fardhu metadata, but can never write it.
    match /fardhu_defaults/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Global feature flags controlled by admin only.
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public Islamic content for home feed.
    match /hadith_contents/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /surah_verses/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User private sunnah habits.
    match /users/{userId}/sunnah_habits/{habitId} {
      allow read, write: if isOwner(userId);
    }

    // User profile meta. Client can only manage basic profile fields.
    match /users/{userId}/meta/{docId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && docId == "profile"
                    && request.resource.data.keys().hasOnly(["name", "email", "avatarBase64", "updatedAt"]);
      allow update: if isOwner(userId)
                    && docId == "profile"
                    && request.resource.data.diff(resource.data).changedKeys()
                      .hasOnly(["name", "email", "avatarBase64", "updatedAt"]);
      allow delete: if isOwner(userId);
    }

    // Deny all other paths by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
